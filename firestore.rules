rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    /* User profiles: every signed-in user may read basic profiles
       (needed for the people picker and names), but you can only
       write your OWN profile. Admins (custom claim) can read all. */
    match /users/{uid} {
      allow read: if signedIn() || isAdmin();
      allow create: if isSelf(uid) && request.resource.data.uid == uid;
      allow update: if isAdmin() || isSelf(uid);
      allow delete: if isAdmin();
    }

    /* Conversations: members only. Direct chats (room starts with "d:")
       can never be joined by a third person — the member keys must stay
       within the two uids encoded in the room key. Room chats ("r:")
       may be joined by any signed-in user who knows the secret name. */
    match /conversations/{cid} {
      function isMember() { return signedIn() && resource.data.members[request.auth.uid] == true; }
      function isMemberNew() { return signedIn() && request.resource.data.members[request.auth.uid] == true; }
      function noMembersRemoved() {
        return resource.data.members.diff(request.resource.data.members).affectedKeys().size() == 0;
      }
      function directMembersOk() {
        return !request.resource.data.room.matches('d:.*')
          || request.resource.data.members.keys().hasOnly(request.resource.data.room.split(':'));
      }

      allow read: if isAdmin() || isMember();
      allow create: if signedIn() && isMemberNew() && directMembersOk();
      allow update: if isAdmin() || (isMemberNew() && noMembersRemoved()
        && (!request.resource.data.room.matches('d:.*') || isMember() || request.resource.data.members.keys().hasOnly(request.resource.data.room.split(':'))));
      allow delete: if isAdmin();
    }

    /* Messages: members of the parent conversation can read them and can
       append their own messages. Only admins can change or delete history. */
    match /conversations/{cid}/messages/{mid} {
      function parentMember() {
        return signedIn()
          && get(/databases/$(database)/documents/conversations/$(cid)).data.members[request.auth.uid] == true;
      }
      allow read: if isAdmin() || parentMember();
      allow create: if isAdmin() || (parentMember() && request.resource.data.senderId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
