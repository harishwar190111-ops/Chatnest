  if (old) { try { old.stop(); } catch (e) {} }
  CALL.stream = new MediaStream([...CALL.stream.getAudioTracks(), nt]);
  CALL.facing = next;
  const lv = $('#callLocal');
  lv.srcObject = ns;
  lv.style.transform = next === 'user' ? 'scaleX(-1)' : 'none';
  toast(next === 'user' ? 'Front camera' : 'Back camera');
}
function endCall(reason) {
  if (CALL.state === 'idle') return;
  sendProto(CALL.h, { type: 'call-end', callId: CALL.callId });
  finishCall(reason);
}
function finishCall(reason) {
  if (CALL.state === 'idle') return;
  const e = callEls();
  callStopRing();
  clearTimeout(CALL.outTimeout);
  clearInterval(CALL.durTimer);
  try { if (CALL.pc) CALL.pc.close(); } catch (er) {}
  if (CALL.stream) CALL.stream.getTracks().forEach(t => { try { t.stop(); } catch (er) {} });
  try { e.remote.srcObject = null; } catch (er) {}
  try { $('#callAudio').srcObject = null; } catch (er) {}
  try { e.local.srcObject = null; } catch (er) {}
  Object.assign(CALL, { state: 'idle', h: null, chatId: null, callId: null, pc: null, stream: null, remoteStream: null, muted: false, camOff: false, speaker: false, t0: 0, durTimer: null, outTimeout: null, pendingOffer: null, pendingIce: [] });
  e.scr.classList.add('hidden');
  if (reason) toast(reason);
}

