    for (let i = 0; i < 6; i++) dots.appendChild(document.createElement('span'));
    wrap.appendChild(dots);
    const err = document.createElement('div'); err.className = 'pin-err'; wrap.appendChild(err);
    const grid = document.createElement('div'); grid.className = 'pin-grid';
    ['1','2','3','4','5','6','7','8','9','','0','back'].forEach(k => {
      const b = document.createElement('button');
      if (k === '') { b.disabled = true; b.style.background = 'transparent'; b.style.border = 'none'; }
      else if (k === 'back') b.innerHTML = '<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M22 3H7c-.7 0-1.2.4-1.6.9L0 12l5.4 8.1c.4.5.9.9 1.6.9h15a2 2 0 002-2V5a2 2 0 00-2-2zm-3 12.6L17.6 17 14 13.4 10.4 17 9 15.6 12.6 12 9 8.4 10.4 7 14 10.6 17.6 7 19 8.4 15.4 12 19 15.6z"/></svg>';
      else b.textContent = k;
      b.addEventListener('click', () => {
        if (k === 'back') { pin = pin.slice(0, -1); paint(); }
        else if (k) { if (pin.length < 6) { pin += k; paint(); } }
      });
      grid.appendChild(b);
    });
    wrap.appendChild(grid);
    const acts = document.createElement('div'); acts.className = 'pin-actions';
    if (cancelable) {
      const c = document.createElement('button'); c.textContent = cfg.cancelLabel || 'Cancel';
      c.addEventListener('click', () => { cleanup(); resolve(null); });
      acts.appendChild(c);
    }
    const okBtn = document.createElement('button'); okBtn.className = 'ok'; okBtn.textContent = cfg.okLabel || 'OK';
    okBtn.addEventListener('click', submit);
    acts.appendChild(okBtn);
    wrap.appendChild(acts);
    host.appendChild(wrap);
    if (!cfg.dark) $('#pinmodal').classList.remove('hidden');
    if (cfg.dark) $('#lock').classList.remove('hidden');

    let pin = '', busy = false;
    function paint() {
      $$('span', dots).forEach((d, i) => d.classList.toggle('fill', i < pin.length));
      okBtn.disabled = pin.length < 4;
    }
    async function submit() {
      if (busy || pin.length < 4) return;
      busy = true; err.textContent = ''; okBtn.disabled = true;
      let problem = null;
      if (cfg.validate) {
        try { problem = await cfg.validate(pin); }
        catch (e) { problem = 'Something went wrong. Try again.'; }
      }
      if (problem) {
        err.textContent = problem;
        pin = ''; paint();
        wrap.classList.remove('shake'); void wrap.offsetWidth; wrap.classList.add('shake');
        busy = false;
      } else {
        const val = pin; cleanup(); resolve(val);
      }
    }
    function cleanup() {
      if (cfg.dark) $('#lock').classList.add('hidden'); else $('#pinmodal').classList.add('hidden');
      host.innerHTML = '';
    }
    paint();
  });
}

