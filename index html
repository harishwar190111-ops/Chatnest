}
async function renameFlow(chat) {
  const name = await promptDlg('Rename chat', 'Enter the new chat name.', chat.name, 'Chat name', 'Important: the other person must use this exact new name too, or you will not be connected anymore.');
  if (!name || name.trim() === chat.name) return;
  const nn = normName(name);
  if (S.chats.some(c => c.id !== chat.id && normName(c.name) === nn)) { toast('You already have a chat with this name', 'err'); return; }
  chat.name = name.trim();
  await DB.put('chats', chat);
  $('#chatName').textContent = chat.name;
  const av = $('#chatAvatar');
  av.textContent = chat.name.slice(0, 1).toUpperCase();
  renderChatLists();
  const h = NETS.get(chat.id);
  if (h) destroyNet(h);
  getNet(chat); // rejoin with new room key
  toast('Renamed. Make sure the other person uses this same name.', 'ok', 4500);
}

/* ---------------- background picker ---------------- */
function bgPicker(selected, onPick, withReset) {
  return new Promise(res => {
    let html = '<div class="mhead">Chat background</div><div class="mbody">Pick a background.</div><div class="bggrid"></div>' +
      '<div class="mrow">' + (withReset ? '<button class="rst" style="color:#d64545;font-weight:600">Reset to default</button>' : '') + '<button class="cancel">Cancel</button></div>';
    const box = dlg(html);
    const grid = $('.bggrid', box);
    if ($('.rst', box)) $('.rst', box).addEventListener('click', () => { closeDlg(); onPick(null); res(null); });
    BG.forEach((b, i) => {
      const d = document.createElement('div');
      d.className = 'bgopt' + (i === selected ? ' sel' : '');
      d.setAttribute('style', bgStyle(i));
      const t = document.createElement('div'); t.className = 'tick'; t.textContent = '✓';
      const n = document.createElement('div'); n.className = 'bname'; n.textContent = b.name;
      d.appendChild(t); d.appendChild(n);
      d.addEventListener('click', () => {
        $$('.bgopt', grid).forEach(x => x.classList.remove('sel'));
        d.classList.add('sel');
        setTimeout(() => { closeDlg(); onPick(i); res(i); }, 180);
      });
      grid.appendChild(d);
    });
    $('.cancel', box).addEventListener('click', () => { closeDlg(); res(null); });
  });
}

/* ---------------- settings ---------------- */
async function enterSettings() {
  if (S.settings.pinHash) {
    const pin = await pinPad({ title: 'Enter your password', sub: 'Password is required to open Settings' });
    if (pin === null) return;
    showScreen('settings');
  } else {
    showScreen('settings');
  }
}
function refreshSettingsUi() {
  $('#pinDesc').textContent = S.settings.pinHash ? 'Password is set — tap to change or remove' : 'Password not set — tap to create one';
  const sw = $('#soundSw');
  sw.classList.toggle('on', !!S.settings.sound);
  $('#videoLimitSel').value = String(S.settings.maxVideoMB || 500);
  $('#videoLimitSub').textContent = 'Up to ' + (S.settings.maxVideoMB || 500) + ' MB';
  $('#bgDesc').textContent = 'Current: ' + (BG[S.settings.bg] ? BG[S.settings.bg].name : 'Classic Doodle');
  $('#ringtoneDesc').textContent = 'Current: ' + (RINGTONES[S.settings.ringtone] || RINGTONES[0]).name + ' — tap to change';
}
async function ringtoneFlow() {
  const cur = S.settings.ringtone || 0;
  const items = RINGTONES.map((r, i) => ({ label: (i === cur ? '✓ ' : '') + r.name, key: i }));
  const it = await actionSheet(items, 'Call ringtone — tap one to preview & save');
  if (!it) return;
  S.settings.ringtone = it.key;
  await setSetting('ringtone', it.key);
  refreshSettingsUi();
  ringBurst(RINGTONES[it.key]);
  toast('Ringtone saved: ' + RINGTONES[it.key].name, 'ok');
}
async function pinManageFlow() {
  if (!S.settings.pinHash) {
    const p1 = await pinPad({ title: 'Create opening password', sub: '4–6 digits, asked when the app opens', okLabel: 'Set' });
    if (p1 === null) return;
    const p2 = await pinPad({ title: 'Confirm password', sub: 'Enter the same password again', okLabel: 'Confirm', validate: p => p === p1 ? null : 'Passwords do not match' });
    if (p2 === null) return;
    S.settings.pinHash = await hashPin(p2);
    await setSetting('pinHash', S.settings.pinHash);
    refreshSettingsUi();
    toast('Opening password set', 'ok');
    return;
  }
  const it = await actionSheet([
    { label: 'Change password', key: 'chg' },
    { label: 'Remove password', key: 'rm', danger: true }
  ], 'Opening password');
  if (!it) return;
  if (it.key === 'chg') {
    const cur = await pinPad({ title: 'Enter current password', validate: async p => (await pinMatches(p, S.settings.pinHash)) ? null : 'Wrong password' });
    if (cur === null) return;
    const p1 = await pinPad({ title: 'New password', sub: '4–6 digits', okLabel: 'Set', validate: p => p.length >= 4 ? null : 'At least 4 digits' });
    if (p1 === null) return;
    const p2 = await pinPad({ title: 'Confirm new password', validate: p => p === p1 ? null : 'Passwords do not match' });
    if (p2 === null) return;
    S.settings.pinHash = await hashPin(p2);
    await setSetting('pinHash', S.settings.pinHash);
    toast('Password changed', 'ok');
  } else if (it.key === 'rm') {
    const cur = await pinPad({ title: 'Enter current password', validate: async p => (await pinMatches(p, S.settings.pinHash)) ? null : 'Wrong password' });
    if (cur === null) return;
    if (await confirmDlg('Remove password?', 'The app will open without asking for a password.', 'Remove', true)) {
      S.settings.pinHash = null;
      await setSetting('pinHash', null);
      refreshSettingsUi();
      toast('Password removed');
    }
  }
}

/* ---------------- file picking ---------------- */
function pickFile(mode) {
  const inp = $('#fileInput');
  inp.value = '';
  if (mode === 'photo') { inp.accept = 'image/*'; inp.removeAttribute('capture'); }
  else if (mode === 'video') { inp.accept = 'video/*'; inp.removeAttribute('capture'); }
  else if (mode === 'camera') { inp.accept = 'image/*'; inp.setAttribute('capture', 'environment'); }
  else if (mode === 'selfie') { inp.accept = 'image/*'; inp.setAttribute('capture', 'user'); }
  inp.click();
}
function initAttach() {
  $$('#attachSheet .asrow').forEach(row => {
    row.addEventListener('click', () => {
      hideAttach();
      setTimeout(() => pickFile(row.dataset.pick), 120);
    });
  });
  $('#attachBtn').addEventListener('click', showAttach);
  $('#attachOverlay').addEventListener('click', hideAttach);
}
function showAttach() { $('#attachSheet').classList.add('show'); $('#attachOverlay').classList.remove('hidden'); }
function hideAttach() { $('#attachSheet').classList.remove('show'); $('#attachOverlay').classList.add('hidden'); }

/* ---------------- init & wiring ---------------- */
async function init() {
  S.settings.pinHash = await getSetting('pinHash', null);
  S.settings.bg = await getSetting('bg', 0) || 0;
  S.settings.sound = await getSetting('sound', true);
  S.settings.maxVideoMB = await getSetting('maxVideoMB', 500);
  S.settings.ringtone = (await getSetting('ringtone', 0)) || 0;
  await loadChats();
  renderChatLists();
  refreshSettingsUi();

  if (S.settings.pinHash) {
    S.locked = true;
    await pinPad({ dark: true, cancelable: false, title: ' ', sub: ' ', validate: async p => (await pinMatches(p, S.settings.pinHash)) ? null : 'Wrong password — try again' });
    S.locked = false;
  }

  /* connect every chat in the background */
  S.chats.forEach(c => getNet(c));

  /* home */
  $('#btnDrawer').addEventListener('click', openDrawer);
  $('#drawerOverlay').addEventListener('click', closeDrawer);
  $('#btnNewEmpty').addEventListener('click', newChatFlow);
  $('#newchatfab').addEventListener('click', newChatFlow);
  $('#dNewChat').addEventListener('click', () => { closeDrawer(); newChatFlow(); });
  $('#dSettings').addEventListener('click', () => { closeDrawer(); enterSettings(); });

  /* chat view */
  $('#btnBack').addEventListener('click', () => { if (SEL.active) exitSelect(); else goHome(); });
  $('#btnChatMenu').addEventListener('click', chatMenuFlow);
  $('#selDel').addEventListener('click', deleteSelected);
  // selection-mode taps (event delegation)
  $('#messages').addEventListener('click', e => {
    if (!SEL.active) return;
    const m = e.target.closest && e.target.closest('.msg');
    if (m) { e.stopPropagation(); toggleSel(m.dataset.id); }
  });
  // block the browser's own long-press text/image menus inside chats
  $('#messages').addEventListener('contextmenu', e => e.preventDefault());
  $('#sendBtn').addEventListener('click', doSend);
  $('#replyCancel').addEventListener('click', clearReply);
  $('#btnCall').addEventListener('click', () => startCall(false));
  $('#btnVCall').addEventListener('click', () => startCall(true));
  $('#msgInput').addEventListener('keydown', e => { if (e.key === 'Enter' && !e.repeat) { e.preventDefault(); doSend(); } });
  $('#msgInput').addEventListener('input', () => { updateComposerButtons(); onTypingInput(); });
  updateComposerButtons();

  /* mic / recording */
  $('#micBtn').addEventListener('click', startRecording);
  $('#recCancel').addEventListener('click', () => { if (REC.rec) { REC.cancelled = true; REC.rec.stop(); } });
  $('#recLock').addEventListener('click', () => {
    REC.locked = true;
    $('#recLock').classList.add('hidden');
    $('#recSend').classList.remove('hidden');
    toast('Recording locked — tap ➤ to send, 🗑 to cancel', 'ok', 3000);
  });
  $('#recSend').addEventListener('click', () => { if (REC.rec) REC.rec.stop(); });

  /* gallery */
  $('#gClose').addEventListener('click', closeGallery);
  $('#gPrev').addEventListener('click', () => galleryNav(-1));
  $('#gNext').addEventListener('click', () => galleryNav(1));
  $('#gallery').addEventListener('click', e => { if (e.target.id === 'gStage') closeGallery(); });
  document.addEventListener('keydown', e => {
    if ($('#gallery').classList.contains('hidden')) return;
    if (e.key === 'Escape') closeGallery();
    if (e.key === 'ArrowLeft') galleryNav(-1);
    if (e.key === 'ArrowRight') galleryNav(1);
  });
  let gx = null;
  const stage = $('#gStage');
  stage.addEventListener('touchstart', e => { gx = e.touches[0].clientX; }, { passive: true });
  stage.addEventListener('touchend', e => {
    if (gx === null) return;
    const dx = e.changedTouches[0].clientX - gx;
    if (Math.abs(dx) > 60) galleryNav(dx < 0 ? 1 : -1);
    gx = null;
  }, { passive: true });

  /* attach */
  initAttach();
  $('#fileInput').addEventListener('change', async e => {
    const f = e.target.files && e.target.files[0];
    e.target.value = '';
    if (f) await sendFile(f);
  });

  /* settings */
  $('#btnSettingsBack').addEventListener('click', () => showScreen('home'));
  $('#sPin').addEventListener('click', pinManageFlow);
  $('#sLockNow').addEventListener('click', async () => {
    if (!S.settings.pinHash) { toast('Set an opening password first'); return; }
    showScreen('home');
    closeDrawer();
    setTimeout(async () => {
      await pinPad({ dark: true, cancelable: false, title: ' ', sub: ' ', validate: async p => (await pinMatches(p, S.settings.pinHash)) ? null : 'Wrong password — try again' });
    }, 150);
  });
  $('#sBg').addEventListener('click', async () => {
    await bgPicker(S.settings.bg, i => {
      S.settings.bg = i;
      setSetting('bg', i);
      applyChatBg();
      refreshSettingsUi();
      toast('Background saved: ' + BG[i].name, 'ok');
    });
  });
  $('#sSound').addEventListener('click', async () => {
    S.settings.sound = !S.settings.sound;
    await setSetting('sound', S.settings.sound);
    refreshSettingsUi();
    if (S.settings.sound) beep();
  });
  $('#sRingtone').addEventListener('click', ringtoneFlow);
  $('#videoLimitSel').addEventListener('change', async e => {
    S.settings.maxVideoMB = parseInt(e.target.value, 10) || 500;
    await setSetting('maxVideoMB', S.settings.maxVideoMB);
    refreshSettingsUi();
    toast('Video limit: ' + S.settings.maxVideoMB + ' MB', 'ok');
  });
  $('#sWipe').addEventListener('click', async () => {
    if (await confirmDlg('Delete all data?', 'Every chat, message, photo, video and setting will be permanently erased. This cannot be undone.', 'Delete everything', true)) {
      destroyAllNets();
      await DB.clear('messages'); await DB.clear('chats'); await DB.clear('settings');
      toast('All data deleted. Reloading…');
      setTimeout(() => location.reload(), 900);
    }
  });

  /* re-ack seen when returning to the app, and refresh connection status */
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState !== 'visible') return;
    const chat = activeChat();
    if (chat && !$('#chatview').classList.contains('hidden')) {
      const h = NETS.get(chat.id);
      if (h) {
        updateNetUi(h);
        DB.msgsOf(chat.id).then(msgs => {
          sendSeen(h, msgs.filter(m => m.dir === 'them').map(m => m.id));
        }).catch(() => {});
      }
    }
  });

  window.addEventListener('beforeunload', () => { destroyAllNets(); });
}
function doSend() {
  const inp = $('#msgInput');
  const v = inp.value.trim();
  if (!v) return;
  inp.value = '';
  updateComposerButtons();
  sendText(v);
}
init().catch(e => {
  console.error(e);
  toast('Something went wrong while starting the app', 'err', 6000);
});
</script>
</body>
</html>
