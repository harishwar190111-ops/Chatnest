/* ---------------- chat actions ---------------- */
async function newChatFlow() {
  const name = await promptDlg('New chat', 'Both people must create a chat with the exact same name to connect.', '', 'e.g. Me & Sarah', 'The chat name is a private room key — share it only with the person you chat with.');
  if (!name) return;
  const nn = normName(name);
  if (!nn) { toast('Please enter a chat name', 'err'); return; }
  if (S.chats.some(c => normName(c.name) === nn)) { toast('You already have a chat with this name', 'err'); return; }
  const chat = { id: uuid(), name: name.trim(), created: Date.now(), lastTs: Date.now(), unread: 0 };
  S.chats.unshift(chat);
  await DB.put('chats', chat);
  renderChatLists();
  getNet(chat); // start connecting right away
  toast('Chat created. Share the exact name "' + chat.name + '" with the other person.', 'ok', 5000);
  openChat(chat.id);
}
async function chatMenuFlow() {
  const chat = activeChat();
  if (!chat) return;
  const it = await actionSheet([
    { label: 'Copy invite / chat name', key: 'invite' },
    { label: 'Rename chat', key: 'rename' },
    { label: 'Chat background', key: 'bg' },
    { label: 'Select messages', key: 'select' },
    { label: 'Clear messages', key: 'clear' },
    { label: 'Delete chat', key: 'del', danger: true }
  ], chat.name);
  if (!it) return;
  if (it.key === 'invite') inviteFlow(chat);
  else if (it.key === 'rename') renameFlow(chat);
  else if (it.key === 'select') enterSelect();
  else if (it.key === 'bg') {
    const cur = (chat.bg === undefined || chat.bg === null) ? (S.settings.bg || 0) : chat.bg;
    await bgPicker(cur, i => {
      chat.bg = i;
      DB.put('chats', chat);
      applyChatBg();
      toast(i === null ? 'Background reset to app default' : 'Background saved: ' + (BG[i] ? BG[i].name : ''), 'ok');
    }, true);
  }
  else if (it.key === 'clear') {
    if (await confirmDlg('Clear messages?', 'All messages in "' + chat.name + '" will be removed from this device.', 'Clear', true)) {
      await DB.delMsgsOf(chat.id);
      chat.lastMsg = ''; chat.lastTs = Date.now(); chat.unread = 0;
      await DB.put('chats', chat);
      revokeUrls();
      await renderMessages();
      renderChatLists();
      toast('Messages cleared');
    }
  }
  else if (it.key === 'del') {
    if (await confirmDlg('Delete chat?', 'The chat "' + chat.name + '" and all its messages will be permanently removed from this device.', 'Delete', true)) {
      const h = NETS.get(chat.id);
      if (h) destroyNet(h);
      await DB.delMsgsOf(chat.id);
      await DB.del('chats', chat.id);
      S.chats = S.chats.filter(c => c.id !== chat.id);
      goHome();
      toast('Chat deleted');
    }
  }
}
