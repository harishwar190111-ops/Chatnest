/* ---------------- PIN / password ---------------- */
async function hashPin(pin) {
  try {
    if (window.crypto && crypto.subtle) {
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode('chatnest:' + pin));
      return { alg: 'sha256', v: Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('') };
    }
  } catch (e) { /* fall through */ }
  return { alg: 'c', v: cyrb53('a:' + pin) + '.' + cyrb53('b:' + pin, 7) };
}
async function pinMatches(pin, stored) {
  if (!stored) return false;
  const h = await hashPin(pin);
  return h.alg === stored.alg && h.v === stored.v;
}

function pinPad(cfg) {
