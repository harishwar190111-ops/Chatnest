/* ---------------- networking: one persistent connection per chat ---------------- */
const NETS = new Map(); // chatId -> handle
function loadPeerLib() {
  if (window.Peer) return Promise.resolve(window.Peer);
  if (NET_LIB.loading) return NET_LIB.loading;
  const CDNS = ['https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js', 'https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js'];
  NET_LIB.loading = new Promise((res, rej) => {
    let i = 0;
    const tryNext = () => {
      if (window.Peer) return res(window.Peer);
      if (i >= CDNS.length) return rej(new Error('offline'));
      const s = document.createElement('script');
      s.src = CDNS[i++];
      s.onload = () => { window.Peer ? res(window.Peer) : (s.remove(), tryNext()); };
      s.onerror = () => { s.remove(); tryNext(); };
      document.head.appendChild(s);
    };
    tryNext();
    setTimeout(() => { if (!window.Peer) rej(new Error('timeout')); }, 15000);
  }).catch(e => { NET_LIB.loading = null; throw e; });
  return NET_LIB.loading;
}
const NET_LIB = { loading: null };

function getNet(chat) {
  let h = NETS.get(chat.id);
  if (!h) {
    h = { chatId: chat.id, peer: null, conns: [], role: null, token: 0, room: null, status: 'offline', retryTimer: null, typing: false, typingTimer: null, pend: [], xchain: null, inflight: new Set() };
    NETS.set(chat.id, h);
    connectNet(h, chat);
  }
  return h;
}
function destroyNet(h) {
  h.token++;
  if (CALL.state !== 'idle' && CALL.h === h) finishCall('Call ended');
  clearTimeout(h.retryTimer);
  clearTimeout(h.typingTimer);
  try { if (h.peer) h.peer.destroy(); } catch (e) {}
  h.conns = []; h.peer = null;
  NETS.delete(h.chatId);
  if (h.typing) { h.typing = false; renderChatLists(); }
  updateNetUi(h);
}
function destroyAllNets() { Array.from(NETS.values()).forEach(destroyNet); }

function updateNetUi(h) {
  const el = $('#connState');
  if (!el) return;
  if (h.chatId !== S.activeId || $('#chatview').classList.contains('hidden')) return;
  if (h.typing) { el.className = 's-ok'; $('.txt', el).textContent = 'typing…'; $('.txt', el).classList.add('typing'); return; }
  $('.txt', el).classList.remove('typing');
  const n = h.conns.length;
  if (n > 0) { el.className = 's-ok'; $('.txt', el).textContent = n === 1 ? 'Connected' : 'Connected (' + n + ')'; }
  else if (h.status === 'waiting') { el.className = 's-wait'; $('.txt', el).textContent = 'Waiting for partner…'; }
  else if (h.status === 'connecting') { el.className = 's-wait'; $('.txt', el).textContent = 'Connecting…'; }
  else { el.className = 's-err'; $('.txt', el).textContent = 'Offline — check internet'; }
}
function setStatus(h, kind) {
  h.status = kind;
  updateNetUi(h);
}

async function connectNet(h, chat) {
  const tok = ++h.token;
  h.room = roomKey(chat.name);
  setStatus(h, 'connecting');
  let PeerLib;
  try { PeerLib = await loadPeerLib(); }
  catch (e) {
    if (tok === h.token) {
      setStatus(h, 'offline');
      if (h.chatId === S.activeId) toast('No internet yet — will connect automatically. Messages will send once online.', 'err', 4500);
      // keep retrying the whole connect (the library load is retried too)
      clearTimeout(h.retryTimer);
      h.retryTimer = setTimeout(() => {
        const c = S.chats.find(x => x.id === h.chatId);
        if (h.token === tok && c) connectNet(h, c);
      }, 5000);
    }
    return;
  }
  if (tok !== h.token) return;
  joinAsHost(tok, PeerLib);

  function fatalRetry() {
    if (tok !== h.token) return;
    clearTimeout(h.retryTimer);
    h.retryTimer = setTimeout(() => {
      const c = S.chats.find(x => x.id === h.chatId);
      if (tok !== h.token || !c) return;
      try { if (h.peer) h.peer.destroy(); } catch (e) {}
      connectNet(h, c);
    }, 3000);
  }
  function joinAsHost(tok, PeerLib) {
    let p;
    try { p = new PeerLib(h.room, window.PEER_OPTS || undefined); }
    catch (e) { setStatus(h, 'offline'); fatalRetry(); return; }
    h.peer = p; h.role = 'host';
    p.on('open', () => { if (tok === h.token) setStatus(h, 'waiting'); });
    p.on('connection', c => {
      if (tok !== h.token) { try { c.close(); } catch (e) {} return; }
      wireConn(c, h);
    });
    p.on('error', e => {
      if (tok !== h.token) return;
      if (e && e.type === 'unavailable-id') {
        try { p.destroy(); } catch (er) {}
        joinAsClient(tok, PeerLib);
      } else if (e && (e.type === 'network' || e.type === 'server-error' || e.type === 'socket-error' || e.type === 'socket-closed' || e.type === 'browser-incompatible')) {
        setStatus(h, 'offline'); fatalRetry();
      }
    });
    p.on('disconnected', () => { if (tok === h.token) { try { p.reconnect(); } catch (e) {} } });
  }
  function joinAsClient(tok, PeerLib) {
    let p;
    try { p = new PeerLib(undefined, window.PEER_OPTS || undefined); }
    catch (e) { setStatus(h, 'offline'); fatalRetry(); return; }
    h.peer = p; h.role = 'client';
    p.on('open', () => {
      if (tok !== h.token) return;
      setStatus(h, 'connecting');
      const c = p.connect(h.room, { reliable: true });
      wireConn(c, h);
    });
    p.on('error', e => {
      if (tok !== h.token) return;
      if (e && e.type === 'peer-unavailable') {
        try { p.destroy(); } catch (er) {}
        setStatus(h, 'waiting');
        fatalRetry();
      } else if (e && (e.type === 'network' || e.type === 'server-error' || e.type === 'socket-error' || e.type === 'socket-closed')) {
        setStatus(h, 'offline'); fatalRetry();
      }
    });
