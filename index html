    if (h.inflight.has(msg.id)) return;
    const conns = h.conns.filter(c => c.open);
    if (!conns.length) { msg.status = 'queued'; await DB.put('messages', msg); refreshBubble(msg); return; }
    h.inflight.add(msg.id);
    try {
    msg.status = 'sending';
    refreshBubble(msg);
    const CHUNK = CHUNK_SIZE;
    const total = msg.size;
    try {
      for (const c of conns) c.send({ type: 'file-start', id: msg.id, kind: msg.kind, name: msg.name, size: msg.size, mime: msg.mime, dur: msg.dur || 0, ts: msg.ts, reply: msg.replyTo || null });
