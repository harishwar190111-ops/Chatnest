function ringBurst(rt) {
  const ctx = audioCtx();
  if (ctx) {
    try {
      rt.pattern.forEach(t => {
        const o = ctx.createOscillator(), g = ctx.createGain();
        o.frequency.value = t[0]; o.connect(g); g.connect(ctx.destination);
        g.gain.setValueAtTime(0.001, ctx.currentTime + t[1]);
        g.gain.exponentialRampToValueAtTime(0.2, ctx.currentTime + t[1] + 0.03);
        g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + t[1] + t[2]);
        o.start(ctx.currentTime + t[1]); o.stop(ctx.currentTime + t[1] + t[2] + 0.05);
      });
    } catch (e) {}
  }
  try { if (navigator.vibrate) navigator.vibrate([400, 200, 400]); } catch (e) {}
}
function callRing() {
  callStopRing();
