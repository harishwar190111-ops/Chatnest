function beep() {
  if (!S.settings.sound) return;
  try {
    const ctx = audioCtx();
    if (!ctx) return;
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.type = 'sine'; o.frequency.value = 880;
    g.gain.setValueAtTime(0.001, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.12, ctx.currentTime + 0.02);
    g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.25);
    o.connect(g); g.connect(ctx.destination);
    o.start(); o.stop(ctx.currentTime + 0.3);
  } catch (e) { /* ignore */ }
}

/* ---------------- database (IndexedDB) ---------------- */
const DB = (() => {
  let dbp = null;
  function open() {
    if (dbp) return dbp;
    dbp = new Promise((res, rej) => {
      const rq = indexedDB.open('chatnest-db', 1);
      rq.onupgradeneeded = () => {
        const d = rq.result;
        if (!d.objectStoreNames.contains('settings')) d.createObjectStore('settings');
        if (!d.objectStoreNames.contains('chats')) d.createObjectStore('chats', { keyPath: 'id' });
        if (!d.objectStoreNames.contains('messages')) {
          const m = d.createObjectStore('messages', { keyPath: 'id' });
          m.createIndex('chatId_ts', ['chatId', 'ts']);
        }
      };
      rq.onsuccess = () => res(rq.result);
      rq.onerror = () => rej(rq.error);
    });
    return dbp;
  }
  const done = r => new Promise((res, rej) => { r.onsuccess = () => res(r.result); r.onerror = () => rej(r.error); });
  return {
    async put(store, val, key) { const db = await open(); return done(db.transaction(store, 'readwrite').objectStore(store).put(val, key)); },
    async get(store, key) { const db = await open(); return done(db.transaction(store).objectStore(store).get(key)); },
    async del(store, key) { const db = await open(); return done(db.transaction(store, 'readwrite').objectStore(store).delete(key)); },
    async all(store) { const db = await open(); return done(db.transaction(store).objectStore(store).getAll()); },
    async clear(store) { const db = await open(); return done(db.transaction(store, 'readwrite').objectStore(store).clear()); },
    async msgsOf(chatId) {
      const db = await open();
      const idx = db.transaction('messages').objectStore('messages').index('chatId_ts');
      return done(idx.getAll(IDBKeyRange.bound([chatId, 0], [chatId, Number.MAX_SAFE_INTEGER])));
    },
    async delMsgsOf(chatId) {
      const db = await open();
      return new Promise((res, rej) => {
        const t = db.transaction('messages', 'readwrite');
        const rq = t.objectStore('messages').index('chatId_ts').openCursor(IDBKeyRange.bound([chatId, 0], [chatId, Number.MAX_SAFE_INTEGER]));
        rq.onsuccess = () => { const c = rq.result; if (c) { c.delete(); c.continue(); } };
        t.oncomplete = () => res(); t.onerror = () => rej(t.error);
      });
    }
  };
})();
