<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#008069">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>ChatNest</title>
<style>
  :root {
    --green: #008069;
    --green-dark: #005c4b;
    --my-bubble: #d9fdd3;
    --their-bubble: #ffffff;
    --txt: #111b21;
    --meta: #667781;
    --bg-page: #f0f2f5;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
  html, body { height: 100%; }
  body {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: #d5dbd6; color: var(--txt);
    height: 100dvh; overflow: hidden;
    display: flex; justify-content: center;
  }
  #shell {
    width: 100%; max-width: 560px; height: 100%;
    display: flex; flex-direction: column; position: relative; overflow: hidden;
    background: var(--bg-page);
    box-shadow: 0 0 30px rgba(0,0,0,.25);
  }
  .hidden { display: none !important; }
  button { font: inherit; border: none; background: none; cursor: pointer; color: inherit; }
  input, select { font: inherit; }
  .ibtn {
    width: 40px; height: 40px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; flex: 0 0 auto;
  }
  .ibtn:active { background: rgba(255,255,255,.15); }
  .ibtn svg { width: 22px; height: 22px; }

  /* ---------- generic header ---------- */
  .topbar {
    background: var(--green); color: #fff; min-height: 56px;
    display: flex; align-items: center; gap: 6px; padding: 0 8px;
    padding-top: env(safe-area-inset-top);
    flex: 0 0 auto; user-select: none;
  }
  .topbar .title { font-size: 19px; font-weight: 600; flex: 1; padding: 0 4px; }

  /* ---------- lock screen ---------- */
  #lock {
    position: absolute; inset: 0; z-index: 60;
    background: linear-gradient(170deg, #005c4b 0%, #008069 60%, #128c7e 100%);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    color: #fff; padding: 24px;
  }
  #lock .logo {
    width: 88px; height: 88px; border-radius: 28px; background: rgba(255,255,255,.14);
    display: flex; align-items: center; justify-content: center; margin-bottom: 14px;
    border: 1px solid rgba(255,255,255,.25);
  }
  #lock .logo svg { width: 48px; height: 48px; }
  #lock h1 { font-size: 26px; font-weight: 600; letter-spacing: .5px; }
  #lock .sub { opacity: .85; margin-top: 6px; font-size: 14px; }

  /* ---------- pin pad ---------- */
  .pinwrap { margin-top: 26px; display: flex; flex-direction: column; align-items: center; width: 100%; }
  .pin-dots { display: flex; gap: 14px; margin: 18px 0 6px; }
  .pin-dots span {
    width: 13px; height: 13px; border-radius: 50%;
    border: 2px solid rgba(255,255,255,.75); transition: background .15s;
  }
  .pin-dots span.fill { background: #fff; border-color: #fff; }
  .pin-err { color: #ffd7d7; font-size: 13px; min-height: 18px; margin-bottom: 10px; text-align: center; }
  .pin-grid { display: grid; grid-template-columns: repeat(3, 68px); gap: 16px; margin-top: 4px; }
  .pin-grid button {
    width: 68px; height: 68px; border-radius: 50%;
    background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.22);
    color: #fff; font-size: 24px; font-weight: 500;
    display: flex; align-items: center; justify-content: center;
  }
  .pin-grid button:active { background: rgba(255,255,255,.32); }
  .pin-actions { margin-top: 22px; display: flex; gap: 14px; }
  .pin-actions button {
    color: #fff; font-size: 15px; font-weight: 600;
    padding: 10px 22px; border-radius: 22px; background: rgba(255,255,255,.14);
    border: 1px solid rgba(255,255,255,.25);
  }
  .pin-actions button:disabled { opacity: .35; }
  .shake { animation: shake .4s; }
  @keyframes shake {
    0%,100% { transform: translateX(0); }
    20%,60% { transform: translateX(-10px); }
    40%,80% { transform: translateX(10px); }
  }
  #pinmodal {
    position: fixed; inset: 0; z-index: 80; background: rgba(0,0,0,.55);
    display: flex; align-items: center; justify-content: center;
  }
  #pinmodal .pin-box {
    background: #fff; color: var(--txt); border-radius: 22px; padding: 26px 22px 20px;
    width: min(92vw, 360px); display: flex; flex-direction: column; align-items: center;
    box-shadow: 0 12px 40px rgba(0,0,0,.35);
  }
  #pinmodal h3 { font-size: 18px; }
  #pinmodal .sub { color: var(--meta); font-size: 13px; margin-top: 4px; text-align: center; }
  #pinmodal .pin-dots span { border-color: #00a884; }
  #pinmodal .pin-dots span.fill { background: #00a884; border-color: #00a884; }
  #pinmodal .pin-err { color: #d64545; }
  #pinmodal .pin-grid button { background: #f0f2f5; border: none; color: var(--txt); }
  #pinmodal .pin-grid button:active { background: #d4fdd6; }
  #pinmodal .pin-actions button { background: #f0f2f5; border: none; color: var(--green-dark); }
  #pinmodal .pin-actions button.ok { background: var(--green); color: #fff; }
  #pinmodal .pin-actions button:disabled { opacity: .4; }

  /* ---------- home ---------- */
  #home { position: absolute; inset: 0; display: flex; flex-direction: column; }
  #chatlist { flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch; background: #fff; }
  .chatrow {
    display: flex; align-items: center; gap: 13px; padding: 11px 14px;
    border-bottom: 1px solid #f0f0f0; cursor: pointer;
  }
  .chatrow:active { background: #f5f6f6; }
  .avatar {
    width: 49px; height: 49px; border-radius: 50%; flex: 0 0 auto;
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 20px; font-weight: 600; background: #6a7f8a;
  }
  .chatrow .mid { flex: 1; min-width: 0; }
  .chatrow .nm { font-size: 16.5px; font-weight: 500; display: flex; align-items: center; gap: 6px; }
  .chatrow .prev {
    color: var(--meta); font-size: 13.5px; margin-top: 2px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .chatrow .prev.typing { color: #00a884; font-style: italic; }
  .chatrow .side { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
  .chatrow .tm { color: var(--meta); font-size: 11.5px; }
  .badge {
    background: #25d366; color: #fff; border-radius: 12px; min-width: 20px; height: 20px;
    font-size: 12px; display: flex; align-items: center; justify-content: center; padding: 0 6px;
  }
  #homeEmpty {
    flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 14px; padding: 40px 28px; text-align: center; color: #5a6672; background: #fff;
  }
  #homeEmpty .big { font-size: 52px; }
  #homeEmpty h2 { font-size: 19px; color: var(--txt); }
  #homeEmpty p { font-size: 13.5px; line-height: 1.55; max-width: 340px; }
  #homeEmpty .newbtn {
    margin-top: 6px; background: var(--green); color: #fff; border-radius: 26px;
    padding: 13px 30px; font-size: 15.5px; font-weight: 600;
    display: flex; align-items: center; gap: 8px;
  }
  #newchatfab {
    position: absolute; right: 18px; bottom: calc(18px + env(safe-area-inset-bottom));
    width: 56px; height: 56px; border-radius: 50%; background: var(--green); color: #fff;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 14px rgba(0,0,0,.3); z-index: 5;
  }
  #newchatfab svg { width: 26px; height: 26px; }

  /* ---------- drawer ---------- */
  #drawerOverlay {
    position: absolute; inset: 0; background: rgba(0,0,0,.45); z-index: 38;
    opacity: 0; pointer-events: none; transition: opacity .22s;
  }
  #drawerOverlay.show { opacity: 1; pointer-events: auto; }
  #drawer {
    position: absolute; top: 0; bottom: 0; left: 0; width: min(82vw, 320px);
    background: #fff; z-index: 40; transform: translateX(-102%);
    transition: transform .24s ease-out; display: flex; flex-direction: column;
    box-shadow: 4px 0 20px rgba(0,0,0,.2);
  }
  #drawer.show { transform: translateX(0); }
  #drawer .dhead {
    background: var(--green); color: #fff; padding: calc(14px + env(safe-area-inset-top)) 16px 14px;
  }
  #drawer .dhead .row { display: flex; align-items: center; gap: 12px; }
  #drawer .dhead .nm { font-size: 17px; font-weight: 600; }
  #drawer .dhead .sub { font-size: 12px; opacity: .85; margin-top: 2px; }
  .dlabel {
    font-size: 12.5px; font-weight: 700; color: var(--meta);
    padding: 12px 18px 4px; letter-spacing: .4px; text-transform: uppercase;
  }
  #drawerChatList { flex: 1; overflow-y: auto; }
  .drow { display: flex; align-items: center; gap: 14px; padding: 11px 18px; cursor: pointer; }
  .drow:active { background: #f0f2f5; }
  .drow .icn { color: var(--meta); display: flex; }
  .drow .icn svg { width: 22px; height: 22px; }
  .drow .txt { font-size: 15.5px; flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .drow .txt.typing { color: #00a884; font-style: italic; }
  .drow .badge { flex: 0 0 auto; }

  /* ---------- chat view ---------- */
  #chatview { position: absolute; inset: 0; display: flex; flex-direction: column; }
  #chatHead .avatar { width: 40px; height: 40px; font-size: 17px; }
  #chatHead .who { flex: 1; min-width: 0; }
  #chatHead .nm { font-size: 16.5px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #connState { font-size: 12px; display: flex; align-items: center; gap: 5px; margin-top: 1px; }
  #connState .dot { width: 8px; height: 8px; border-radius: 50%; background: #999; flex: 0 0 auto; }
  #connState.s-ok .dot { background: #7fe3a0; }
  #connState.s-wait .dot { background: #ffce6b; }
  #connState.s-err .dot { background: #ff9c9c; }
  #connState .txt { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #connState .txt.typing { color: #c8f7dd; font-style: italic; }

  #messages {
    flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch;
    padding: 12px 10px 10px; display: flex; flex-direction: column; gap: 3px;
    background-color: #efe7dd;
  }
  .datechip {
    align-self: center; background: #ffffffcc; color: #54656f; font-size: 12px;
    padding: 5px 12px; border-radius: 8px; margin: 8px 0 6px; box-shadow: 0 1px 1px rgba(0,0,0,.06);
  }
  .msg { display: flex; max-width: 82%; }
  .msg.me { align-self: flex-end; }
  .msg.them { align-self: flex-start; }
  .bubble {
    background: var(--their-bubble); border-radius: 12px; padding: 6px 8px 6px 9px;
    box-shadow: 0 1px 1px rgba(0,0,0,.12); font-size: 15px; line-height: 1.42;
    word-wrap: break-word; min-width: 78px; position: relative; max-width: 100%;
  }
  .msg.me .bubble { background: var(--my-bubble); border-top-right-radius: 4px; }
  .msg.them .bubble { border-top-left-radius: 4px; }
  .bubble .meta {
    float: right; margin: 6px -2px -3px 8px; color: var(--meta);
    font-size: 11px; display: inline-flex; align-items: center; gap: 3px; user-select: none;
  }
  .bubble .meta .fail { color: #e03b3b; font-weight: 700; }
  .bubble .meta .edited { font-style: italic; }
  .bubble img.media, .bubble video.media {
    display: block; max-width: 270px; max-height: 340px; border-radius: 9px; margin-bottom: 3px;
    background: #000;
  }
  .bubble video.media { max-height: 380px; }
  .vwrap { position: relative; display: inline-block; max-width: 270px; }
  .vwrap video.media { pointer-events: none; }
  .vplay {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,.08); border-radius: 9px;
  }
  .vplay span {
    width: 44px; height: 44px; border-radius: 50%; background: rgba(0,0,0,.55); color: #fff;
    display: flex; align-items: center; justify-content: center;
  }
  .progressWrap { position: relative; width: 220px; }
  .progressBox {
    width: 220px; height: 140px; border-radius: 9px; margin-bottom: 3px;
    background: #d3e4dc; display: flex; align-items: center; justify-content: center;
    flex-direction: column; gap: 8px; color: #1d5c4a; font-size: 13px;
  }
  .pbar { width: 180px; height: 6px; border-radius: 3px; background: #ffffff88; overflow: hidden; }
  .pbar i { display: block; height: 100%; width: 0%; background: #25d366; transition: width .2s; }
  .msg.me .bubble .progressBox { background: #c7e6c2; }

  /* no text selection inside chats — long-press is for menus, like WhatsApp */
  #messages, #messages * { -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
  .meta .tk.seen { color: #53bdeb; font-weight: 700; }

  /* selection mode (select multiple messages) */
  .selbox {
    width: 26px; height: 26px; border-radius: 50%; border: 2px solid #aab5bb;
    flex: 0 0 auto; align-self: center; margin-right: 6px; display: none;
    align-items: center; justify-content: center; color: #fff; font-size: 15px;
  }
  #chatview.selecting .selbox { display: flex; }
  .msg.sel .selbox { background: #25d366; border-color: #25d366; }
  .msg.sel .selbox:before { content: '✓'; }
  #selDel { display: none; }
  #chatview.selecting #selDel { display: flex; }
  #chatview.selecting #btnChatMenu { display: none; }
  .loadmore { cursor: pointer; border: none; font: inherit; background: #ffffffcc; }
  img.media, video.media { -webkit-touch-callout: none; }

  /* voice message bubble */
  .audio-row { display: flex; align-items: center; gap: 9px; min-width: 220px; max-width: 250px; padding: 3px 0 1px; }
  .aplay {
    width: 36px; height: 36px; border-radius: 50%; background: #e9edef; color: #0b7a67;
    display: flex; align-items: center; justify-content: center; flex: 0 0 auto;
  }
  .aplay svg { width: 16px; height: 16px; }
  .awave { flex: 1; display: flex; align-items: center; gap: 2px; height: 28px; min-width: 100px; }
  .awave i { flex: 1; background: #c9d6d0; border-radius: 1px; min-width: 2px; }
  .awave i.on { background: #25d366; }
  .adur { font-size: 11px; color: var(--meta); min-width: 32px; text-align: right; font-variant-numeric: tabular-nums; }

  /* composer */
  #composer {
    flex: 0 0 auto; display: flex; align-items: center; gap: 8px;
    padding: 7px 9px calc(7px + env(safe-area-inset-bottom)); background: #f0f2f5;
  }
  #attachBtn, #sendBtn, #micBtn {
    width: 44px; height: 44px; border-radius: 50%; flex: 0 0 auto;
    display: flex; align-items: center; justify-content: center;
  }
  #attachBtn { background: #fff; color: #3b4a54; box-shadow: 0 1px 2px rgba(0,0,0,.12); }
  #attachBtn svg, #sendBtn svg, #micBtn svg { width: 24px; height: 24px; }
  #sendBtn, #micBtn { background: var(--green); color: #fff; }
  #sendBtn:disabled { opacity: .5; }
  #msgInput {
    flex: 1; background: #fff; border: none; border-radius: 22px;
    padding: 11px 16px; font-size: 15.5px; outline: none; min-width: 0;
  }

  /* recording bar */
  #recBar {
    flex: 0 0 auto; display: flex; align-items: center; gap: 10px;
    padding: 7px 9px calc(7px + env(safe-area-inset-bottom)); background: #f0f2f5;
  }
  .rbbtn {
    width: 44px; height: 44px; border-radius: 50%; background: #fff; color: #3b4a54;
    display: flex; align-items: center; justify-content: center; flex: 0 0 auto;
    box-shadow: 0 1px 2px rgba(0,0,0,.12);
  }
  .rbbtn svg { width: 22px; height: 22px; }
  #recCancel { color: #d64545; }
  #recInfo { display: flex; align-items: center; gap: 8px; flex: 0 0 auto; }
  #recTime { font-variant-numeric: tabular-nums; font-size: 14.5px; color: #d64545; min-width: 42px; }
  .recdot { width: 10px; height: 10px; border-radius: 50%; background: #d64545; animation: pulse 1s infinite; }
  @keyframes pulse { 50% { opacity: .2; } }
  #recBars { flex: 1; display: flex; align-items: center; gap: 3px; height: 26px; justify-content: flex-end; overflow: hidden; }
  #recBars i { width: 3px; background: #00a884; border-radius: 2px; animation: eq .7s ease-in-out infinite alternate; }
  @keyframes eq { from { height: 4px; } to { height: 20px; } }
  #recHint { font-size: 11.5px; color: var(--meta); text-align: center; flex: 1; }

  /* attach sheet */
  #attachSheet {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 45;
    background: #fff; border-radius: 18px 18px 0 0; padding: 6px 0 calc(10px + env(safe-area-inset-bottom));
    transform: translateY(105%); transition: transform .22s ease-out; box-shadow: 0 -6px 24px rgba(0,0,0,.18);
  }
  #attachSheet.show { transform: translateY(0); }
  #attachOverlay { position: absolute; inset: 0; z-index: 44; background: rgba(0,0,0,.4); }
  .asrow { display: flex; align-items: center; gap: 18px; padding: 13px 24px; cursor: pointer; }
  .asrow:active { background: #f0f2f5; }
  .asrow .aicon {
    width: 42px; height: 42px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff;
  }
  .asrow .alabel { font-size: 15.5px; font-weight: 500; }
  .asrow .asub { font-size: 12px; color: var(--meta); margin-top: 1px; }
  .asrow svg { width: 22px; height: 22px; }

  /* ---------- gallery viewer ---------- */
  #gallery {
    position: absolute; inset: 0; z-index: 78; background: rgba(0,0,0,.96);
    display: flex; flex-direction: column;
  }
  .g-top {
    display: flex; justify-content: space-between; align-items: center;
    padding: calc(10px + env(safe-area-inset-top)) 12px 10px; color: #fff;
  }
  #gCount { font-size: 14px; opacity: .9; }
  #gClose { color: #fff; width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; font-size: 24px; }
  #gStage { flex: 1; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  #gStage img { max-width: 96vw; max-height: 76dvh; transition: transform .25s; }
  #gStage img.zoom { transform: scale(2.1); }
  #gStage video { max-width: 96vw; max-height: 76dvh; }
  .gnav {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 46px; height: 46px; border-radius: 50%;
    background: rgba(255,255,255,.16); color: #fff; font-size: 26px;
    display: flex; align-items: center; justify-content: center;
  }
  #gPrev { left: 8px; } #gNext { right: 8px; }

  /* ---------- settings ---------- */
  #settings { position: absolute; inset: 0; display: flex; flex-direction: column; z-index: 30; background: #f0f2f5; }
  #settings .sbody { flex: 1; overflow-y: auto; padding: 14px 0 30px; }
  .ssection { background: #fff; margin: 10px 12px; border-radius: 14px; overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
  .srowitem {
    display: flex; align-items: center; gap: 14px; padding: 13px 16px; cursor: pointer;
    border-bottom: 1px solid #f0f0f0; font-size: 15.5px;
  }
  .srowitem:last-child { border-bottom: none; }
  .srowitem:active { background: #f5f6f6; }
  .srowitem .sic { color: var(--green); display: flex; }
  .srowitem .sic svg { width: 22px; height: 22px; }
  .srowitem .main { flex: 1; min-width: 0; }
  .srowitem .lab { font-size: 15.5px; }
  .srowitem .desc { font-size: 12.5px; color: var(--meta); margin-top: 2px; }
  .srowitem .chev { color: #b0b8bd; }
  .srowitem select { font-size: 14.5px; padding: 6px 8px; border-radius: 8px; border: 1px solid #d7dbdf; background: #fff; }
  .srowitem .sw { position: relative; width: 46px; height: 26px; border-radius: 13px; background: #d7dbdf; transition: background .2s; flex: 0 0 auto; }
  .srowitem .sw i { position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; transition: left .2s; box-shadow: 0 1px 3px rgba(0,0,0,.25); }
  .srowitem .sw.on { background: #25d366; }
  .srowitem .sw.on i { left: 23px; }
  .danger { color: #d64545 !important; }
  .about { text-align: center; color: var(--meta); font-size: 12.5px; padding: 18px 24px 4px; line-height: 1.6; }

  /* ---------- modal / dialogs ---------- */
  #modal {
    position: absolute; inset: 0; z-index: 70; background: rgba(0,0,0,.5);
    display: flex; align-items: center; justify-content: center; padding: 22px;
  }
  .mbox {
    background: #fff; border-radius: 18px; width: min(88vw, 360px); max-height: 82%;
    overflow-y: auto; box-shadow: 0 12px 40px rgba(0,0,0,.35);
  }
  .mbox .mhead { padding: 20px 22px 0; font-size: 18px; font-weight: 600; }
  .mbox .mbody { padding: 10px 22px 4px; color: #3b4a54; font-size: 14.5px; line-height: 1.5; }
  .mbox .mbody .note { font-size: 12.5px; color: var(--meta); margin-top: 8px; }
  .mbox input.minput {
    width: 100%; border: 1.5px solid #d7dbdf; border-radius: 10px; padding: 11px 13px;
    font-size: 15.5px; outline: none; margin-top: 6px;
  }
  .mbox input.minput:focus { border-color: var(--green); }
  .mbox .mrow { display: flex; justify-content: flex-end; padding: 14px 12px 12px; gap: 4px; }
  .mbox .mrow button {
    color: var(--green-dark); font-weight: 600; font-size: 14.5px; padding: 9px 14px; border-radius: 22px;
  }
  .mbox .mrow button.warn { color: #d64545; }
  .mbox .mrow button:active { background: #f0f2f5; }
  .maction { padding: 14px 22px 4px; font-size: 15px; }
  .bigname {
    font-size: 21px; font-weight: 600; text-align: center; background: #f0f2f5;
    border-radius: 12px; padding: 13px; margin-top: 10px; user-select: all; word-break: break-all;
  }

  /* backgrounds picker */
  .bggrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; padding: 12px 18px 18px; }
  .bgopt { height: 92px; border-radius: 12px; border: 2.5px solid transparent; cursor: pointer; position: relative; box-shadow: inset 0 0 0 1px rgba(0,0,0,.08); }
  .bgopt.sel { border-color: var(--green); }
  .bgopt .tick {
    position: absolute; top: 5px; right: 5px; width: 22px; height: 22px; border-radius: 50%;
    background: var(--green); color: #fff; display: none; align-items: center; justify-content: center; font-size: 13px;
  }
  .bgopt.sel .tick { display: flex; }
  .bgopt .bname {
    position: absolute; bottom: 0; left: 0; right: 0; font-size: 10.5px; text-align: center;
    background: rgba(255,255,255,.75); padding: 2px 3px; border-radius: 0 0 9px 9px; color: #333;
  }

  /* ---------- reply (swipe to reply) ---------- */
  .msg { position: relative; }
  .msg.swiping::before {
    content: '\21A9'; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
    font-size: 22px; font-weight: 700; color: var(--green); opacity: .9;
  }
  #inputArea { flex: 0 0 auto; display: flex; flex-direction: column; }
  #replyBar { display: none; align-items: center; gap: 6px; padding: 6px 10px 0; background: #f0f2f5; }
  #replyBar.show { display: flex; }
  #replyBar .rq { flex: 1; min-width: 0; background: #fff; border-left: 4px solid var(--green); border-radius: 8px; padding: 6px 12px; }
  #replyBar .rq-name { color: var(--green); font-size: 12.5px; font-weight: 600; }
  #replyBar .rq-text { color: #54656f; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #replyBar .rq-cancel { color: #54656f; width: 34px; height: 34px; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; font-size: 18px; }
  .bquote { border-left: 4px solid var(--green); background: rgba(0,0,0,.05); border-radius: 6px; padding: 4px 9px; margin: 1px 0 4px; overflow: hidden; }
  .bquote .bq-name { color: #027e63; font-weight: 600; font-size: 12.5px; }
  .bquote .bq-text { color: #54656f; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .fname { font-size: 14px; padding: 4px 2px; word-break: break-all; }

  /* ---------- voice & video calls ---------- */
  #callScreen { position: absolute; inset: 0; z-index: 75; background: #0b141a; display: flex; flex-direction: column; color: #fff; }
  #callRemote { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; background: #000; }
  .call-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.6), rgba(0,0,0,.12) 45%, rgba(0,0,0,.7)); }
  #callLocal { position: absolute; right: 12px; top: calc(70px + env(safe-area-inset-top)); width: 104px; height: 148px; object-fit: cover; border-radius: 14px; border: 2px solid rgba(255,255,255,.45); background: #000; box-shadow: 0 4px 16px rgba(0,0,0,.5); display: none; z-index: 3; }
  #callTop { position: relative; z-index: 2; text-align: center; padding: calc(30px + env(safe-area-inset-top)) 20px 0; }
  #callName { font-size: 22px; font-weight: 600; }
  #callState { font-size: 13.5px; opacity: .85; margin-top: 4px; }
  #callDur { font-size: 15px; margin-top: 2px; font-variant-numeric: tabular-nums; min-height: 18px; }
  #callAvatarWrap { position: relative; z-index: 2; flex: 1; display: none; flex-direction: column; align-items: center; justify-content: center; gap: 14px; }
  #callAvatarWrap.show { display: flex; }
  #callAvatarWrap .avatar { width: 108px; height: 108px; font-size: 42px; }
  #callActions { position: relative; z-index: 2; display: flex; justify-content: center; align-items: center; gap: 20px; padding: 20px 16px calc(30px + env(safe-area-inset-bottom)); flex-wrap: wrap; }
  .cbtn { width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,.16); color: #fff; }
