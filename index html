  const e = callEls();
  try {
    if (CALL.video) {
      e.remote.srcObject = CALL.remoteStream;
      e.remote.style.display = 'block';
      if (e.remote.play) e.remote.play().catch(() => {});
    } else {
      const a = $('#callAudio');
      a.srcObject = CALL.remoteStream;
      if (a.play) a.play().catch(() => {});
    }
  } catch (er) {}
  callVolumes();
}
