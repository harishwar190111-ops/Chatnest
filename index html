/* ---- message gestures: long-press menu + swipe-to-reply ---- */
function attachMsgGestures(el, msg) {
  let lp = null, open = false, sx = 0, sy = 0, moved = false, swiping = false, tx = 0, suppressClick = false;
  const clearLp = () => { if (lp) { clearTimeout(lp); lp = null; } };
  const fireMenu = () => {
    clearLp();
    if (open || SEL.active) return;
    open = true;
    try { if (navigator.vibrate) navigator.vibrate(35); } catch (e) {}
    Promise.resolve(msgMenuFlow(msg)).finally(() => { open = false; });
  };
  const snapBack = () => {
    const bub = el.querySelector('.bubble');
    if (bub) { bub.style.transition = 'transform .18s ease'; bub.style.transform = ''; }
    el.classList.remove('swiping');
    swiping = false; tx = 0;
  };
  el.addEventListener('touchstart', e => {
    const p = e.touches[0];
    sx = p.clientX; sy = p.clientY; moved = false; swiping = false; tx = 0;
    if (!SEL.active) lp = setTimeout(fireMenu, 480);
  }, { passive: true });
  el.addEventListener('touchmove', e => {
    const p = e.touches[0];
    const dx = p.clientX - sx, dy = p.clientY - sy;
    if (!moved && (Math.abs(dx) > 8 || Math.abs(dy) > 8)) { moved = true; clearLp(); }
    if (SEL.active || !moved) return;
    if (Math.abs(dx) > Math.abs(dy) + 6) {
      if (e.cancelable) e.preventDefault();
      swiping = true; suppressClick = true;
      tx = Math.max(0, Math.min(90, dx));
      const bub = el.querySelector('.bubble');
      if (bub) { bub.style.transition = 'none'; bub.style.transform = 'translateX(' + tx + 'px)'; }
      el.classList.add('swiping');
    } else if (swiping) snapBack();
  });
  el.addEventListener('touchend', () => {
    clearLp();
    if (swiping) {
      const trigger = tx >= 55;
      snapBack();
      if (trigger && !SEL.active) {
        try { if (navigator.vibrate) navigator.vibrate(20); } catch (e) {}
        setReply(msg);
      }
    }
  });
  el.addEventListener('touchcancel', () => { clearLp(); if (swiping) snapBack(); });
  /* desktop fallback: long-press with the mouse */
  el.addEventListener('mousedown', e => { if (SEL.active) return; sx = e.clientX; sy = e.clientY; lp = setTimeout(fireMenu, 480); });
  el.addEventListener('mousemove', e => { if (lp && (Math.abs(e.clientX - sx) > 6 || Math.abs(e.clientY - sy) > 6)) clearLp(); });
  ['mouseup', 'mouseleave'].forEach(ev => el.addEventListener(ev, clearLp));
  /* a finished swipe must not open the gallery / trigger taps */
  el.addEventListener('click', e => { if (suppressClick) { e.stopPropagation(); e.preventDefault(); suppressClick = false; } }, true);
  el.addEventListener('contextmenu', e => e.preventDefault());
}
async function msgMenuFlow(msg) {
