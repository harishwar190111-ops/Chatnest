        for (const c of conns) {
          await drain(c);
          if (!c.open) throw new Error('connection closed');
          c.send(buf);
        }
        updateSendProgress(msg.id, end / total);
      }
      for (const c of conns) c.send({ type: 'file-end', id: msg.id });
      msg.status = 'sent';
      await DB.put('messages', msg);
      refreshBubble(msg);
    } catch (e) {
      msg.status = 'failed';
      await DB.put('messages', msg);
      refreshBubble(msg);
      if (S.activeId === h.chatId) toast('Send failed — long-press the message to resend', 'err', 4000);
    }
    } finally { h.inflight.delete(msg.id); }
