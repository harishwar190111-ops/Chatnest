/* ---- microphone / camera permission handling ---- */
function secureMediaHint() {
  const p = (location.protocol || '').toLowerCase();
  if (p === 'file:' || p === 'content:') {
    return 'This is a local file — Chrome never shows the microphone/camera popup for local files, even when the setting says "Ask every time". Put this app online for free (github.io or netlify.com) and open the https link — then the popup appears and calls work.';
  }
  if (!window.isSecureContext) {
    return 'This page is not secure — open it over https, then it can ask for microphone and camera permission and you can tap Allow.';
  }
  return 'Open this app in Chrome and allow microphone and camera when asked.';
}
async function ensureMedia(video) {
  if (!window.isSecureContext || !navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    toast('Calls need microphone ' + (video ? 'and camera ' : '') + 'permission. ' + secureMediaHint(), 'err', 9000);
    return null;
  }
  try {
    if (navigator.permissions && navigator.permissions.query) {
      const pm = await navigator.permissions.query({ name: 'microphone' });
      if (pm.state === 'denied') {
        toast('Microphone is blocked for this page. Tap the \uD83D\uDD12 (or \u22EE) icon next to the address bar \u2192 Permissions \u2192 Allow microphone, then call again.', 'err', 9000);
        return null;
      }
      if (video) {
        const pv = await navigator.permissions.query({ name: 'camera' });
        if (pv.state === 'denied') {
          toast('Camera is blocked for this page. Tap the \uD83D\uDD12 (or \u22EE) icon next to the address bar \u2192 Permissions \u2192 Allow camera, then call again.', 'err', 9000);
          return null;
        }
      }
    }
  } catch (e) { /* Permissions API not supported here — getUserMedia will ask instead */ }
  try {
    return await navigator.mediaDevices.getUserMedia({
      audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true },
      video: video ? { facingMode: CALL.facing, width: { ideal: 640 }, height: { ideal: 480 }, frameRate: { ideal: 15, max: 30 } } : false
    });
  } catch (e) {
    const denied = e && (e.name === 'NotAllowedError' || e.name === 'SecurityError' || e.name === 'PermissionDeniedError');
    if (denied) {
      toast((video ? 'Camera and microphone are ' : 'Microphone is ') + 'blocked. Tap the \uD83D\uDD12 (or \u22EE) icon next to the address bar \u2192 Permissions \u2192 Allow, then call again.', 'err', 9000);
    } else if (e && e.name === 'NotFoundError') {
      toast('No ' + (video ? 'camera' : 'microphone') + ' found on this device', 'err', 6000);
    } else {
      toast('Could not start the ' + (video ? 'camera' : 'microphone') + ' (' + ((e && e.name) || 'error') + '). Try again.', 'err', 6000);
    }
    return null;
  }
}
/* ---- the call's peer connection ---- */
function newCallPc() {
  const pc = new RTCPeerConnection(ICE_SERVERS);
  let discTimer = null;
  pc.onicecandidate = e => {
    if (e.candidate && CALL.pc === pc) {
      sendProto(CALL.h, { type: 'call-ice', callId: CALL.callId, candidate: e.candidate.toJSON ? e.candidate.toJSON() : e.candidate });
    }
  };
  pc.ontrack = e => {
    if (CALL.pc !== pc) return;
    if (e.streams && e.streams[0]) CALL.remoteStream = e.streams[0];
    attachRemote();
    if (CALL.state === 'calling' || CALL.state === 'ringing') callConnected();
  };
  pc.onconnectionstatechange = () => {
    if (CALL.pc !== pc) return;
    const st = pc.connectionState || pc.iceConnectionState || '';
    if (st === 'failed' || st === 'closed') { clearTimeout(discTimer); finishCall('Connection lost'); }
    else if (st === 'disconnected') {
      clearTimeout(discTimer);
      discTimer = setTimeout(() => {
        const s2 = pc.connectionState || pc.iceConnectionState || '';
        if (CALL.pc === pc && (s2 === 'disconnected' || s2 === 'failed' || s2 === 'closed')) finishCall('Connection lost');
      }, 10000);
    } else { clearTimeout(discTimer); }
  };
  return pc;
}
async function startCall(video) {
  if (CALL.state !== 'idle') { toast('Already in a call', 'err'); return; }
  const chat = activeChat();
  if (!chat) return;
  if (REC.rec) { toast('Finish or cancel your voice recording first', 'err'); return; }
  const h = NETS.get(chat.id) || getNet(chat);
  const conn = h.conns.find(c => c.open);
  if (!conn) { toast('Partner is not connected yet — try again when they are online', 'err', 4000); return; }
  const stream = await ensureMedia(video);
  if (!stream) return;
  CALL.state = 'calling'; CALL.h = h; CALL.chatId = chat.id; CALL.callId = uuid();
  CALL.stream = stream; CALL.remoteStream = null; CALL.video = !!video; CALL.facing = 'user';
  CALL.muted = false; CALL.camOff = false; CALL.speaker = false;
  CALL.pendingOffer = null; CALL.pendingIce = [];
  const pc = newCallPc();
  CALL.pc = pc;
  try {
    stream.getTracks().forEach(t => pc.addTrack(t, stream));
    const offer = await pc.createOffer();
    await pc.setLocalDescription(offer);
    const ok = sendProto(h, { type: 'call-offer', callId: CALL.callId, to: conn.peer, video: !!video, sdp: pc.localDescription });
    if (!ok) throw new Error('not connected');
  } catch (e) { finishCall('Call failed'); return; }
  openCallUi('calling');
  callRing();
  clearTimeout(CALL.outTimeout);
  CALL.outTimeout = setTimeout(() => { if (CALL.state === 'calling') finishCall('No answer'); }, 45000);
}
async function handleCallOffer(h, d) {
  if (!d.callId || !d.sdp || typeof d.sdp !== 'object') return;
  if (d.to && h.peer && h.peer.id && d.to !== h.peer.id) return; // offer meant for someone else
  if (CALL.state !== 'idle' || REC.rec) { sendProto(h, { type: 'call-busy', callId: d.callId }); return; }
  CALL.state = 'ringing'; CALL.h = h; CALL.chatId = h.chatId; CALL.callId = d.callId;
  CALL.video = !!d.video; CALL.stream = null; CALL.remoteStream = null; CALL.pc = null; CALL.facing = 'user';
  CALL.muted = false; CALL.camOff = false; CALL.speaker = false;
  CALL.pendingOffer = d.sdp; CALL.pendingIce = [];
  openCallUi('ringing');
  callRing();
  try { if (navigator.vibrate) navigator.vibrate([300, 350, 300, 350, 300]); } catch (e) {}
  clearTimeout(CALL.outTimeout);
  CALL.outTimeout = setTimeout(() => { if (CALL.state === 'ringing') finishCall('Missed call'); }, 45000);
}
async function handleCallAnswer(h, d) {
  if (CALL.state !== 'calling' || CALL.callId !== d.callId || !CALL.pc || !d.sdp) return;
  try {
    await CALL.pc.setRemoteDescription(d.sdp);
    const ice = CALL.pendingIce.splice(0);
    for (const c of ice) { try { await CALL.pc.addIceCandidate(c); } catch (e) {} }
  } catch (e) { finishCall('Call failed'); return; }
  callConnected();
}
async function handleCallIce(h, d) {
  if (!d.candidate || CALL.callId !== d.callId) return;
  if (CALL.pc && CALL.pc.remoteDescription) { try { await CALL.pc.addIceCandidate(d.candidate); } catch (e) {} }
  else CALL.pendingIce.push(d.candidate);
}
async function acceptCall() {
  if (CALL.state !== 'ringing' || !CALL.pendingOffer) return;
  const stream = await ensureMedia(CALL.video);
  if (!stream) { declineCall(); return; }
  CALL.stream = stream;
  try {
    const pc = newCallPc();
    CALL.pc = pc;
    stream.getTracks().forEach(t => pc.addTrack(t, stream));
    await pc.setRemoteDescription(CALL.pendingOffer);
    CALL.pendingOffer = null;
    const ice = CALL.pendingIce.splice(0);
    for (const c of ice) { try { await pc.addIceCandidate(c); } catch (e) {} }
    const ans = await pc.createAnswer();
    await pc.setLocalDescription(ans);
    sendProto(CALL.h, { type: 'call-answer', callId: CALL.callId, sdp: pc.localDescription });
    callConnected();
  } catch (e) { finishCall('Call failed'); }
}
function declineCall() {
  if (CALL.state !== 'ringing') return;
  sendProto(CALL.h, { type: 'call-declined', callId: CALL.callId });
  finishCall(null);
  toast('Call declined');
}
function callConnected() {
  if (CALL.state === 'idle' || CALL.state === 'connected') return;
  callStopRing();
  clearTimeout(CALL.outTimeout);
  CALL.state = 'connected';
  CALL.t0 = Date.now();
  const e = callEls();
  if (CALL.video) e.avWrap.classList.remove('show');
  attachRemote();
  if (CALL.stream && CALL.video) {
    e.local.srcObject = CALL.stream;
    e.local.style.display = 'block';
    e.local.style.transform = CALL.facing === 'user' ? 'scaleX(-1)' : 'none';
  }
  callVolumes();
  e.state.textContent = 'Connected';
  e.dur.textContent = '0:00';
  clearInterval(CALL.durTimer);
  CALL.durTimer = setInterval(() => {
    if (CALL.state === 'connected') $('#callDur').textContent = fmtDur((Date.now() - CALL.t0) / 1000);
  }, 1000);
  renderCallActions();
}
function toggleMute() {
  if (!CALL.stream) return;
  CALL.muted = !CALL.muted;
  CALL.stream.getAudioTracks().forEach(t => { t.enabled = !CALL.muted; });
  renderCallActions();
  toast(CALL.muted ? 'Microphone muted' : 'Microphone on');
}
function toggleSpeaker() {
  CALL.speaker = !CALL.speaker;
  callVolumes();
  renderCallActions();
  toast(CALL.speaker ? 'Speaker on' : 'Speaker off');
}
function toggleCam() {
  if (!CALL.stream || !CALL.video) return;
  CALL.camOff = !CALL.camOff;
  CALL.stream.getVideoTracks().forEach(t => { t.enabled = !CALL.camOff; });
  $('#callLocal').style.visibility = CALL.camOff ? 'hidden' : 'visible';
  renderCallActions();
  toast(CALL.camOff ? 'Camera off' : 'Camera on');
}
async function flipCam() {
  if (!CALL.stream || !CALL.video || !CALL.pc) return;
  const next = CALL.facing === 'user' ? 'environment' : 'user';
  let ns;
  try { ns = await navigator.mediaDevices.getUserMedia({ video: { facingMode: next }, audio: false }); }
  catch (e) { toast('Could not switch camera', 'err'); return; }
  const nt = ns.getVideoTracks()[0];
  try {
    const sender = CALL.pc.getSenders().find(s => s.track && s.track.kind === 'video');
    if (sender) await sender.replaceTrack(nt);
    else CALL.pc.addTrack(nt, ns);
  } catch (e) { ns.getTracks().forEach(t => t.stop()); toast('Could not switch camera', 'err'); return; }
